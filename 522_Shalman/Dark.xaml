<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Buttons ===== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#294C7A"/>
    <!-- тёмно-синий -->
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#35629C"/>
    <!-- чуть ярче -->
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#1F3B5C"/>
    <!-- глубже при нажатии -->

    <!-- ===== TextBoxes ===== -->
    <SolidColorBrush x:Key="TextBoxBackground" Color="#1C2A3A"/>
    <!-- глубокий тёмно-синий -->

    <!-- ===== Page ===== -->
    <SolidColorBrush x:Key="PageBackground" Color="#15202B"/>
    <!-- почти чёрно-синий -->

    <!-- ===== Text & Borders ===== -->
    <SolidColorBrush x:Key="Foreground" Color="#E0ECFF"/>
    <!-- мягкий светло-голубой текст -->
    <SolidColorBrush x:Key="BorderBrush" Color="#35629C"/>
    <!-- рамки приглушённые -->
    <SolidColorBrush x:Key="HyperlinkForeground" Color="#5BA4FF"/>
    <!-- ярко-голубой для ссылок -->
</ResourceDictionary>
