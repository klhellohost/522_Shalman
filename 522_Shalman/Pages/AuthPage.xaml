<Page x:Class="_522_Shalman.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="AuthPage">

	<Grid HorizontalAlignment="Center"
          Width="780"
          Height="460"
          VerticalAlignment="Center"
          Margin="0,20,0,0">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1*"/>
			<ColumnDefinition Width="1.8*"/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Label Content="Логин"
               x:Name="labelLogin"
               Grid.Row="0"
               Grid.Column="0"
               Margin="0,0,15,8"
               HorizontalAlignment="Right"
               Width="70"
               FontSize="15"
               FontWeight="SemiBold"
               VerticalAlignment="Bottom"
               Style="{StaticResource LabelStyle}" />

		<Label Content="Пароль"
               x:Name="labelPass"
               Grid.Row="1"
               Grid.Column="0"
               Margin="0,0,15,8"
               HorizontalAlignment="Right"
               Width="70"
               FontSize="15"
               FontWeight="SemiBold"
               VerticalAlignment="Bottom"
               Style="{StaticResource LabelStyle}" />

		<Label Content="Капча:"
               Name="labelCaptcha"
               Visibility="Hidden"
               Grid.Row="2"
               Grid.Column="0"
               Margin="0,0,15,8"
               HorizontalAlignment="Right"
               Width="70"
               FontSize="15"
               VerticalAlignment="Bottom"
               Style="{StaticResource LabelStyle}" />

		<TextBox x:Name="TextBoxLogin"
                 Grid.Row="0"
                 Grid.Column="1"
                 Margin="10,15,0,0"
                 Height="36"
                 Padding="10,0"
                 FontSize="14"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Left"
                 Width="220"
                 Style="{StaticResource TextBoxStyle}"
                 TextChanged="TextBoxLogin_TextChanged"
                 ToolTip="Введите логин или почту" />

		<PasswordBox x:Name="PasswordBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="10,15,0,0"
                     Height="36"
                     Padding="10,0"
                     FontSize="14"
                     VerticalAlignment="Bottom"
                     HorizontalAlignment="Left"
                     Width="220"
                     Style="{StaticResource PasswordBoxStyle}"
                     PasswordChanged="PasswordBox_PasswordChanged"
                     ToolTip="Введите пароль" />

		<TextBox Grid.Row="2"
                 Grid.Column="1"
                 Visibility="Hidden"
                 x:Name="captcha"
                 Height="44"
                 Width="160"
                 Margin="0,15,0,0"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Right"
                 FontSize="21"
                 FontWeight="Bold"
                 FontStyle="Italic"
                 Foreground="Red"
                 Background="Transparent"
                 IsReadOnly="True"
                 TextAlignment="Center"
                 CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                 ContextMenu="{x:Null}"
                 Style="{StaticResource TextBoxStyle}" />

		<TextBox Grid.Row="2"
                 Grid.Column="1"
                 Visibility="Hidden"
                 x:Name="captchaInput"
                 HorizontalAlignment="Left"
                 Height="36"
                 Margin="10,15,0,0"
                 VerticalAlignment="Top"
                 Width="220"
                 Padding="10,0"
                 FontSize="14"
                 Style="{StaticResource TextBoxStyle}" />

		<StackPanel Grid.Row="3"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10,15,0,0">

			<Button x:Name="ButtonEnter"
                    Content="Вход"
                    Height="42"
                    Width="210"
                    Margin="0,0,0,12"
                    FontSize="15"
                    Style="{StaticResource ButtonStyle}"
                    Click="ButtonEnter_OnClick"
                    ToolTip="Кнопка входа" />

			<Button x:Name="ButtonReg"
                    Content="Регистрация"
                    Height="42"
                    Width="210"
                    Margin="0,0,0,12"
                    FontSize="15"
                    Style="{StaticResource ButtonStyle}"
                    Click="ButtonReg_Click"
                    ToolTip="Кнопка регистрации" />

			<Button x:Name="ButtonChangePassword"
                    Content="Смена пароля"
                    Height="40"
                    Width="210"
                    Margin="0,0,0,12"
                    FontSize="14"
                    Style="{StaticResource ButtonStyle}"
                    Click="ButtonChangePassword_Click"
                    ToolTip="Кнопка смены пароля" />

			<Button x:Name="submitCaptcha"
                    Content="Подтвердить"
                    Height="40"
                    Width="210"
                    Margin="0"
                    FontSize="14"
                    Visibility="Hidden"
                    Style="{StaticResource ButtonStyle}"
                    Click="submitCaptcha_Click"
                    ToolTip="Подтвердить ввод капчи" />
		</StackPanel>
	</Grid>
</Page>