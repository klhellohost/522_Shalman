<Page x:Class="_522_Shalman.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="AdminPage">

	<Grid Margin="30,40">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Button x:Name="BtnTab1"
                Content="Таблица пользователей"
                Style="{StaticResource ButtonStyle}"
                Grid.Row="0" Grid.Column="0"
                Height="44" Width="195"
                Margin="10,0,15,0"
                Padding="12,0"
                FontSize="15"
                Click="BtnTab1_Click"/>

		<Button x:Name="BtnTab2"
                Content="Таблица категорий"
                Style="{StaticResource ButtonStyle}"
                Grid.Row="0" Grid.Column="1"
                Height="44" Width="195"
                Margin="0,0,15,0"
                Padding="12,0"
                FontSize="15"
                Click="BtnTab2_Click"/>

		<Button x:Name="BtnTab3"
                Content="Таблица платежей"
                Style="{StaticResource ButtonStyle}"
                Grid.Row="0" Grid.Column="2"
                Height="44" Width="195"
                Margin="0,0,10,0"
                Padding="12,0"
                FontSize="15"
                Click="BtnTab3_Click"/>

		<Button x:Name="BtnTab4"
                Content="Диаграммы"
                Style="{StaticResource ButtonStyle}"
                Grid.Row="1" Grid.Column="1"
                Height="44" Width="170"
                Margin="0,25,0,0"
                Padding="12,0"
                FontSize="15"
                Click="BtnTab4_Click"/>
	</Grid>
</Page>