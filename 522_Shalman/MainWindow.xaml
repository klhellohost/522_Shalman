<Window x:Class="_522_Shalman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:_522_Shalman"
        Title="Главное окно"
        Height="700"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ResizeMode="CanResizeWithGrip">

	<Grid Background="{DynamicResource PageBackground}">
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<!-- Верхняя панель -->
			<RowDefinition/>
			<!-- Основное содержимое -->
			<RowDefinition Height="30"/>
			<!-- Нижняя строка -->
		</Grid.RowDefinitions>

		<!-- ===== Верхняя панель ===== -->
		<Border Grid.Row="0"
                Background="{DynamicResource ButtonBackground}"
                CornerRadius="0,0,12,12"
                Margin="0,0,0,6"
                Effect="{DynamicResource ShadowEffect}">
			<DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="10,0">

				<!-- Левая часть: Кнопки "Назад" и "Тема" -->
				<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
					<Button x:Name="btnBack"
                            Content="←"
                            Style="{StaticResource ButtonStyle}"
                            Click="btnBack_Click"
                            Width="36"
                            Height="36"
                            FontSize="16"
                            FontWeight="Bold"
                            Margin="5,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            ToolTip="Назад" />

					<Button x:Name="btnThemeToggle"
                            Content="Тема"
                            Style="{StaticResource ButtonStyle}"
                            Click="btnThemeToggle_Click"
                            Margin="8,0,5,0"
                            Padding="14,6"
                            FontSize="13"
                            ToolTip="Переключить тему" />
				</StackPanel>

				<!-- Правая часть: Заголовок (растягивается) -->
				<TextBlock Text="Главное окно"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Foreground}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           DockPanel.Dock="Left"/>
			</DockPanel>
		</Border>

		<!-- ===== Основной контент ===== -->
		<Border Grid.Row="1"
                Margin="10"
                CornerRadius="12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource TextBoxBackground}">
			<Frame x:Name="MainFrame"
                   Source="pages/AuthPage.xaml"
                   NavigationUIVisibility="Hidden"
                   Margin="10"/>
		</Border>

		<!-- ===== Нижняя панель ===== -->
		<DockPanel Grid.Row="2" Margin="0,4,10,0">
			<TextBlock x:Name="tbDateTimeNow"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Style="{StaticResource LinkTextBlockStyle}"
                       DockPanel.Dock="Right"
                       Margin="0,0,10,0"/>
		</DockPanel>
	</Grid>
</Window>